<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArmprodWeatherXplat.ViewModels"
        xmlns:m="using:ArmprodWeatherXplat.Models"
        xmlns:services="clr-namespace:ArmprodWeatherXplat.Services"
        x:Class="ArmprodWeatherXplat.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/ArmprodWeatherIcon.ico"
        Title="Armprod Weather"
        Width="400" Height="800"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Panel>
        <Grid RowDefinitions="Auto,*" IsHitTestVisible="{Binding !IsLoading}">
            
            <!-- TOP BAR WITH SEARCHING & SETTINGS -->
            <StackPanel Grid.Row="0" Margin="20,15,20,5" Spacing="10" ZIndex="1">
                <Grid ColumnDefinitions="*,Auto">
                    <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CityName}"
                                   FontSize="22" 
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding CityName}"/>
                    </DockPanel>
                    
                    <StackPanel Classes="IconButton" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding Favorites.ToggleCurrentFavoriteCommand}"
                                Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" VerticalAlignment="Center">
                            <Panel>
                                <TextBlock Text="★" Foreground="#CC8500" FontSize="24" IsVisible="{Binding Favorites.IsCurrentFavorite}"/>
                                <TextBlock Text="☆" Foreground="#555555" FontSize="24" IsVisible="{Binding !Favorites.IsCurrentFavorite}"/>
                            </Panel>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Background="Transparent" Content="🔄" FontSize="18"/>
                        <Button Command="{Binding Search.ToggleSearchCommand}" Background="Transparent" Content="🔍" FontSize="18"/>
                        <Button Command="{Binding Settings.ToggleSettingsCommand}" Background="Transparent" Content="⚙️" FontSize="18"/>
                    </StackPanel>
                </Grid>

                <!-- OFFLINE BANNER -->
                <Border IsVisible="{Binding IsOffline}"
                        Background="#D32F2F"
                        CornerRadius="8"
                        Padding="10,6"
                        Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="📡❌" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OfflineHeader}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                            <TextBlock Text="{Binding OfflineMessage}" FontSize="11" Foreground="#E0E0E0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FAVORITES BAR -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,10"
                              IsVisible="{Binding Favorites.Favorites.Count}">
                    <ItemsControl ItemsSource="{Binding Favorites.Favorites}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:FavoriteLocation">
                                <Button Classes="FavoriteCityButton" Content="{Binding Name}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Favorites.SelectFavoriteCommand}"
                                        CommandParameter="{Binding}"
                                        CornerRadius="16" Padding="12,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- SETTINGS PANEL -->
                <Border IsVisible="{Binding Settings.IsSettingsOpen}" CornerRadius="12" Padding="16" Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel Spacing="10" Margin="15">
                        <TextBlock Text="{Binding Settings.SettingsTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Settings.ThemeLabel}"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableThemes}" SelectedItem="{Binding Settings.SelectedTheme}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding Settings.LanguageLabel}"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableLanguages}" SelectedItem="{Binding Settings.SelectedLanguage}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding Settings.TemperatureUnitLabel}"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableTemperatureUnits}" SelectedItem="{Binding Settings.SelectedTemperatureUnit}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding Settings.WindSpeedUnitLabel}"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableWindSpeedUnits}" SelectedItem="{Binding Settings.SelectedWindSpeedUnit}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding Settings.TimeFormatLabel}"/>
                        <ComboBox ItemsSource="{Binding Settings.AvailableTimeFormats}" SelectedItem="{Binding Settings.SelectedTimeFormat}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <!-- SEARCH PANEL -->
                <StackPanel IsVisible="{Binding Search.IsSearchOpen}" Spacing="8" PropertyChanged="SearchPanel_PropertyChanged">
                    <TextBox x:Name="SearchInput"
                             Text="{Binding Search.SearchQuery}"
                             PlaceholderText="{Binding Search.SearchPlaceholder}"
                             CornerRadius="10"/>
                    <ListBox ItemsSource="{Binding Search.SearchResults}"
                             SelectedItem="{Binding Search.SelectedSearchResult, Mode=TwoWay}"
                             MaxHeight="200"
                             Background="{DynamicResource SearchBackgroundBrush}" 
                             CornerRadius="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:LocationItem">
                                <TextBlock Text="{Binding DisplayName}" Padding="8,4" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>

            <!-- MAIN SCROLL CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="20,0,20,20" Spacing="20">
                    
                    <!-- HERO SECTOR -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,10,0,10">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🕒" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocalTimeHeader}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocalTimeText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Width="120" Height="120" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="60" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding WeatherIcon}" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{Binding CurrentTemperature}" FontSize="72" FontWeight="Thin" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding WeatherCondition}" FontSize="20" Opacity="0.9" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TempRange}" FontSize="14" Opacity="0.6" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- HOURLY FORECAST -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="20" Padding="15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding HourlyForecastHeader}" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding HourlyForecast}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="20"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HourlyItem">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Time}" FontSize="12" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Temp}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- WEEKLY FORECAST -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="20" Padding="15">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding DailyForecastHeader}" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                            <ItemsControl ItemsSource="{Binding DailyForecast}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DailyItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                            <TextBlock Text="{Binding Day}" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Icon}" Margin="0,0,20,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TempRange}" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- DETAIL GRID -->
                    <UniformGrid Columns="2">
                        <!-- Wind Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding WindHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding WindSpeed}" Classes="CardValue"/>
                                <TextBlock Text="{Binding WindDirectionText}" Classes="CardSubtext"/>
                                <TextBlock Text="{Binding WindGustsText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Humidity Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding HumidityHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding Humidity}" Classes="CardValue"/>
                                <TextBlock Text="{Binding DewPointText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Apparent Temperature Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ApparentTempHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding ApparentTempText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding TempDeltaText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Air Pressure & Trend Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding PressureHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding PressureText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding PressureAdviceText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- UV Index Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding UvIndexHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding UvIndexText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding UvRiskText}" Classes="CardSubtext"/>
                                <TextBlock Text="{Binding PeakUvTimeText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Precipitation Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding PrecipProbHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding PrecipProbText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding PrecipAmountText}" Classes="CardSubtext"/>
                                <TextBlock Text="{Binding HourlyPeakPrecipText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Visibility Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding VisibilityHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding VisibilityText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding VisibilityAdviceText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Cover Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding CloudCoverHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding CloudCoverText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding CloudCoverAdviceText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Sunrise Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SunriseHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding SunriseText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding DaylightDurationText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Sunset Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding SunsetHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding SunsetText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding SunshineText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- AQI Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding AqiHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding AqiText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding AqiAdviceText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                        <!-- Moon Phase Card -->
                        <Border Classes="WeatherCard">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding MoonHeader}" Classes="CardHeader"/>
                                <TextBlock Text="{Binding MoonPhaseText}" Classes="CardValue"/>
                                <TextBlock Text="{Binding MoonRiseSetText}" Classes="CardSubtext"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- LOADING INDICATOR -->
        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" IsVisible="{Binding IsLoading}" ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="40" Height="40" />
                <TextBlock Text="Loading..." FontSize="14" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ERROR PANEL -->
        <Border IsVisible="{Binding HasError}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#FF5555"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="340"
                ZIndex="20">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="⚠️" FontSize="40" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"/>
                <Button Content="Zkuste to znovu / Retry" 
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center"
                        Padding="16,8"
                        CornerRadius="8"/>
            </StackPanel>
        </Border>

    </Panel>
</Window>